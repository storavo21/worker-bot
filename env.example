# ════════════════════════════════════════════════════
#  WORKER BOT — Environment Variables
#  Only 4 variables needed. That's it.
# ════════════════════════════════════════════════════

# URL of your master bot (must be publicly reachable)
MASTER_BOT_URL=https://bot.yourdomain.com

# Same secret as master bot and Cloudflare worker
SHARED_SECRET=you-secret-code

# Unique name for this worker (use worker1, worker2, worker3...)
WORKER_NAME=worker1

# The public URL of THIS worker (so master can reach it back)
# On Render: https://your-app-name.onrender.com
# On Railway: https://your-app-name.up.railway.app
WORKER_PUBLIC_URL=

# Port (optional, default 8081)
WORKER_PORT=8081
